{
    "name": "puth/php",
    "description": "PHP and Laravel client for Puth",
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "guzzlehttp/guzzle": ">=7.0",
        "phpunit/phpunit": ">=9.0"
    },
    "suggest": {
        "laravel/framework": "The Laravel integration under Puth\\Laravel needs Laravel 12 or newer."
    },
    "conflict": {
        "illuminate/support": "<12.0",
        "laravel/framework": "<12.0"
    },
    "autoload": {
        "psr-4": {
            "Puth\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Puth\\Laravel\\PuthServiceProvider"
            ]
        }
    }
}
