{
  "name": "puth",
  "version": "0.10.0",
  "author": {
    "name": "Sebastian Uehlin",
    "email": "s.uehlin@proton.me"
  },
  "type": "module",
  "bin": "./dist/cli.mjs",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    },
    "import": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "description": "Puth (Puppet-Theater) is a versatile browser testing framework with a powerful GUI.",
  "dependencies": {
    "@inquirer/prompts": "^8.8.0",
    "@msgpack/msgpack": "^3.1.3",
    "@puth/client": "^0.2.0",
    "@puth/core": "^0.0.3",
    "@puth/gui": "^0.3.0",
    "@types/diff-match-patch": "^1.0.36",
    "crossws": "^0.4.17",
    "h3": "^2.0.8",
    "meow": "^14.1.0",
    "mitt": "^3.0.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "puppeteer-core": "^25.17.0",
    "sharp": "^0.35.5",
    "tmp": "^0.2.7",
    "uuid": "^14.0.3",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/assert": "^1.5.7",
    "vitest": "^5.1.0"
  },
  "files": [
    "bin/",
    "browser/",
    "dist/",
    "static/",
    "LICENCE"
  ],
  "scripts": {
    "benchmark": "node --expose-gc --import tsx ../../dev/benchmarks/recording.ts",
    "build": "pkgroll --clean-dist",
    "dev": "NODE_ENV=development tsx watch --clear-screen=false src/dev/server.ts",
    "dev:browser:install": "tsx src/dev/browser-install.ts",
    "dev:server": "npm run dev",
    "dev:server:debug": "DEBUG=\"puppeteer:*\" NODE_ENV=development tsx watch --clear-screen=false src/dev/server.ts > puth.log 2> puth.cdp.log",
    "test": "vitest run",
    "test:only:remote": "TEST_ONLY_REMOTE=true vitest run test/api.test.ts",
    "test:only:plugins": "vitest 'tst/plugins/**/*.ts",
    "test:only:translation": "vitest test/translation/**/*.ts",
    "test:api": "vitest test/api.test.ts",
    "prepublishOnly": "node ../../bin/check-dist.mjs && npm run ci:browser:install && npm test",
    "version": "git add -A src",
    "postversion": "git push && git push --tags",
    "image:install": "npm install && cd gui && npm install",
    "image:build": "npm run build && cd gui && npm run build",
    "image:cleanup": "rm -rf src && rm -rf gui",
    "ci:browser:install": "npm run dev:browser:install ci",
    "ci:server": "DEBUG=\"puppeteer:*\" dist/cli.mjs start --debug > puth.log 2> puth.cdp.log"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puth-io/puth.git",
    "directory": "workspaces/puth"
  },
  "homepage": "https://puth.io",
  "license": "SEE LICENSE IN LICENCE"
}
