{
  "name": "@puth/zstd-decoder",
  "version": "0.0.0",
  "description": "zstd's decoder built to WebAssembly from the official release, with a checked TypeScript wrapper.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/puth-io/puth.git",
    "directory": "workspaces/zstd-decoder"
  },
  "license": "SEE LICENSE IN README.md",
  "types": "./dist/zstd.d.mts",
  "module": "./dist/zstd.mjs",
  "exports": {
    ".": {
      "types": "./dist/zstd.d.mts",
      "default": "./dist/zstd.mjs"
    },
    "./zstd-decoder.wasm": "./zstd-decoder.wasm"
  },
  "scripts": {
    "build": "pkgroll --clean-dist",
    "prepublishOnly": "node ../../bin/check-dist.mjs",
    "test": "node --test test/*.test.ts"
  },
  "files": [
    "dist/",
    "zstd-decoder.wasm",
    "LICENSE-zstd"
  ]
}
